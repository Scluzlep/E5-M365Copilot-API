# ==========================================
# Server Binding Configuration
# ==========================================
# The network interface to bind to. (0.0.0.0 exposes it to all interfaces)
HOST=127.0.0.1
# The port to listen on.
PORT=8000


# ==========================================
# Web Admin Dashboard Authentication
# ==========================================
# The mandatory access password for the Web Dashboard. (Required, no default)
WEB_AUTH_PASSWORD=your_secure_password


# ==========================================
# API Rate Limiting Configuration
# ==========================================
# Requests per minute the bridge will accept (0 to disable)
# Default 12 rpm sits safely below the upstream Copilot ceiling
RATE_LIMIT_RPM=12
# Max requests allowed back-to-back before pacing kicks in
RATE_LIMIT_BURST=4
